# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8000
API_PREFIX=/api/v1

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/db?sslmode=require&channel_binding=require

# ─── Redis (optional — app works without it, caching disabled) ────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=<generate-min-64-char-random-string>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_REFRESH_SECRET=<generate-min-64-char-random-string>

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://qura-superadmin.onrender.com,https://qura-hms.onrender.com,https://qura-b2c.onrender.com

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10

# ─── Email (SMTP) — optional ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Qura Healthcare <noreply@qurahealthcare.in>

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs
